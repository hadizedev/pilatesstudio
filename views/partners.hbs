</div>

<!-- Schedule Detail Modal -->
<div class="modal fade" id="scheduleDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border: none;">
            <div class="modal-header" style="background: #2c3e50; color: #fff; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title"><i class="fas fa-calendar-alt"></i> Schedule Detail</h5>
                <button type="button" class="modal-close-btn" data-bs-dismiss="modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body p-4">
                <div class="schedule-detail-card" id="modalScheduleDetail">
                    <!-- Filled by JS -->
                </div>
                <div id="modalMembersList">
                    <h6 style="color: #2c3e50; font-weight: 600; margin-bottom: 10px;"><i class="fas fa-users"></i> Students</h6>
                    <div id="modalMembers">
                        <!-- Filled by JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Day Schedule Modal (click on a day) -->
<div class="modal fade" id="dayScheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 15px; border: none;">
            <div class="modal-header" style="background: #2c3e50; color: #fff; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title" id="dayModalTitle"><i class="fas fa-calendar-day"></i> Schedule</h5>
                <button type="button" class="modal-close-btn" data-bs-dismiss="modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body p-4" id="dayScheduleList">
                <!-- Filled by JS -->
            </div>
        </div>
    </div>
</div>

<script>
let currentWeekStart = null;
let schedulesData = [];
let trainerInfo = null;

// Format date as YYYY-MM-DD in local timezone (avoids UTC shift from toISOString)
function formatDateLocal(d) {
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
}

// Initialize
document.addEventListener('DOMContentLoaded', async function() {
    // Load trainer profile
    try {
        const res = await fetch('/api/partners/profile');
        const data = await res.json();
        if (data.success) {
            trainerInfo = data.data;
            updateTrainerUI(trainerInfo);
        } else {
            window.location.href = '/partners/login';
        }
    } catch (e) {
        window.location.href = '/partners/login';
    }

    // Set current week
    const today = new Date();
    const day = today.getDay();
    const diff = day === 0 ? -6 : 1 - day;
    currentWeekStart = new Date(today);
    currentWeekStart.setDate(today.getDate() + diff);
    currentWeekStart.setHours(0, 0, 0, 0);

    await loadSchedules();
});

function updateTrainerUI(trainer) {
    const avatarUrl = trainer.image || `https://ui-avatars.com/api/?name=${encodeURIComponent(trainer.name)}&background=3498db&color=fff&size=60`;
    document.getElementById('trainerAvatar').src = avatarUrl;
    document.getElementById('trainerName').textContent = trainer.name;
    document.getElementById('trainerSpecialization').textContent = trainer.specialization || 'Trainer';

    // Profile section
    document.getElementById('profileAvatar').src = trainer.image || `https://ui-avatars.com/api/?name=${encodeURIComponent(trainer.name)}&background=3498db&color=fff&size=100`;
    document.getElementById('profileName').textContent = trainer.name;
    document.getElementById('profileStatus').textContent = trainer.status || 'Active';
    document.getElementById('profileEmail').textContent = trainer.email || '-';
    document.getElementById('profilePhone').textContent = trainer.phone || '-';
    document.getElementById('profileSpecialization').textContent = trainer.specialization || '-';
    document.getElementById('profileJoined').textContent = trainer.joined_date || '-';
    document.getElementById('profileBio').textContent = trainer.bio || '-';
}

async function loadSchedules() {
    const dateStr = formatDateLocal(currentWeekStart);
    try {
        const res = await fetch(`/api/partners/schedules?date=${dateStr}`);
        const data = await res.json();
        if (data.success) {
            schedulesData = data.data;
            renderCalendar();
            updateStats();
        }
    } catch (e) {
        console.error('Error loading schedules:', e);
    }
}

function renderCalendar() {
    const grid = document.getElementById('weekGrid');
    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // Update week label
    const weekEnd = new Date(currentWeekStart);
    weekEnd.setDate(weekEnd.getDate() + 6);
    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    document.getElementById('weekLabel').textContent =
        `${currentWeekStart.getDate()} ${monthNames[currentWeekStart.getMonth()]} - ${weekEnd.getDate()} ${monthNames[weekEnd.getMonth()]} ${weekEnd.getFullYear()}`;

    let html = '';

    // Day headers
    for (let i = 0; i < 7; i++) {
        const d = new Date(currentWeekStart);
        d.setDate(d.getDate() + i);
        html += `<div class="day-header">${days[i]}<br><small style="font-weight:400; color:#bdc3c7;">${d.getDate()}</small></div>`;
    }

    // Day columns
    for (let i = 0; i < 7; i++) {
        const d = new Date(currentWeekStart);
        d.setDate(d.getDate() + i);
        d.setHours(0, 0, 0, 0);
        const dateStr = formatDateLocal(d);
        const isToday = d.getTime() === today.getTime();

        // Filter schedules for this day
        const daySchedules = schedulesData.filter(s => {
            const sDate = s.schedule_time ? s.schedule_time.split(' ')[0] : '';
            return sDate === dateStr;
        }).sort((a, b) => a.schedule_time.localeCompare(b.schedule_time));

        html += `<div class="day-col ${isToday ? 'today' : ''}" onclick="showDaySchedules('${dateStr}')">`;
        html += `<div class="day-number">${isToday ? `<div style="background:#2c3e50;color:#fff;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;">${d.getDate()}</div>` : d.getDate()}</div>`;

        daySchedules.forEach(s => {
            const time = s.schedule_time ? s.schedule_time.split(' ')[1] || '' : '';
            const timeShort = time ? time.substring(0, 5) : '';
            const statusClass = (s.status || 'Active').toLowerCase() === 'active' ? 'active' : 
                               (s.status || '').toLowerCase() === 'cancelled' ? 'cancelled' : 'completed';
            html += `<div class="schedule-pill ${statusClass}" onclick="event.stopPropagation(); showScheduleDetail('${s.id}')" title="${s.class_name} - ${timeShort}">
                ${timeShort} ${s.class_name}
            </div>`;
        });

        html += `</div>`;
    }

    grid.innerHTML = html;
}

function updateStats() {
    const now = new Date();
    const todayStr = formatDateLocal(now);

    document.getElementById('statTotalWeek').textContent = schedulesData.length;

    const totalMembers = schedulesData.reduce((sum, s) => sum + (s.members_count || 0), 0);
    document.getElementById('statTotalMembers').textContent = totalMembers;

    const upcoming = schedulesData.filter(s => {
        const sDate = s.schedule_time ? s.schedule_time.split(' ')[0] : '';
        return sDate === todayStr && new Date(s.schedule_time) > now && (s.status || 'Active').toLowerCase() === 'active';
    }).length;
    document.getElementById('statUpcoming').textContent = upcoming;

    const completed = schedulesData.filter(s => (s.status || '').toLowerCase() === 'completed').length;
    document.getElementById('statCompleted').textContent = completed;
}

function showDaySchedules(dateStr) {
    const daySchedules = schedulesData.filter(s => {
        const sDate = s.schedule_time ? s.schedule_time.split(' ')[0] : '';
        return sDate === dateStr;
    }).sort((a, b) => a.schedule_time.localeCompare(b.schedule_time));

    const d = new Date(dateStr + 'T00:00:00');
    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    document.getElementById('dayModalTitle').innerHTML = `<i class="fas fa-calendar-day"></i> ${dayNames[d.getDay()]}, ${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}`;

    let html = '';
    if (daySchedules.length === 0) {
        html = '<div class="text-center py-4" style="color: #7f8c8d;"><i class="fas fa-calendar-times fa-3x mb-3" style="opacity:0.3;"></i><p>No classes scheduled for this day</p></div>';
    } else {
        daySchedules.forEach(s => {
            const time = s.schedule_time ? s.schedule_time.split(' ')[1] || '' : '';
            const timeShort = time ? time.substring(0, 5) : '-';
            const statusBadge = (s.status || 'Active').toLowerCase() === 'active' ? 
                '<span class="badge bg-success">Active</span>' : 
                `<span class="badge bg-secondary">${s.status}</span>`;

            html += `<div class="schedule-detail-card" style="cursor:pointer;" onclick="$('#dayScheduleModal').modal('hide'); setTimeout(() => showScheduleDetail('${s.id}'), 300);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <div>
                        <strong style="font-size:16px; color:#2c3e50;">${s.class_name || 'Class'}</strong>
                        ${statusBadge}
                    </div>
                    <span style="font-size:13px; color:#7f8c8d;"><i class="fas fa-clock"></i> ${timeShort}</span>
                </div>
                <div style="display:flex; gap:20px; font-size:13px; color:#7f8c8d;">
                    <span><i class="fas fa-users"></i> ${s.members_count || 0}/${s.class_capacity || '-'} students</span>
                    <span><i class="fas fa-hourglass-half"></i> ${s.class_duration || '-'} min</span>
                    ${s.gender_restriction ? `<span><i class="fas fa-venus-mars"></i> ${s.gender_restriction}</span>` : ''}
                </div>
                ${s.notes ? `<div style="margin-top:8px; font-size:12px; color:#95a5a6;"><i class="fas fa-sticky-note"></i> ${s.notes}</div>` : ''}
            </div>`;
        });
    }

    document.getElementById('dayScheduleList').innerHTML = html;
    $('#dayScheduleModal').modal('show');
}

function showScheduleDetail(scheduleId) {
    const schedule = schedulesData.find(s => s.id === scheduleId);
    if (!schedule) return;

    const time = schedule.schedule_time ? schedule.schedule_time.split(' ')[1] || '' : '';
    const timeShort = time ? time.substring(0, 5) : '-';
    const date = schedule.schedule_time ? schedule.schedule_time.split(' ')[0] : '-';

    let detailHtml = `
        <div class="detail-row"><span class="detail-label">Class</span><span class="detail-value">${schedule.class_name || '-'}</span></div>
        <div class="detail-row"><span class="detail-label">Date</span><span class="detail-value">${date}</span></div>
        <div class="detail-row"><span class="detail-label">Time</span><span class="detail-value">${timeShort}</span></div>
        <div class="detail-row"><span class="detail-label">Duration</span><span class="detail-value">${schedule.class_duration || '-'} min</span></div>
        <div class="detail-row"><span class="detail-label">Capacity</span><span class="detail-value">${schedule.members_count || 0} / ${schedule.class_capacity || '-'}</span></div>
        <div class="detail-row"><span class="detail-label">Status</span><span class="detail-value">${schedule.status || 'Active'}</span></div>
        ${schedule.gender_restriction ? `<div class="detail-row"><span class="detail-label">Gender</span><span class="detail-value">${schedule.gender_restriction}</span></div>` : ''}
        ${schedule.notes ? `<div class="detail-row"><span class="detail-label">Notes</span><span class="detail-value">${schedule.notes}</span></div>` : ''}
    `;
    document.getElementById('modalScheduleDetail').innerHTML = detailHtml;

    // Members list
    let membersHtml = '';
    if (schedule.members && schedule.members.length > 0) {
        schedule.members.forEach(m => {
            const genderIcon = m.gender === 'M' ? 'fa-mars' : m.gender === 'F' ? 'fa-venus' : 'fa-user';
            membersHtml += `<span class="member-badge"><i class="fas ${genderIcon}"></i> ${m.name}</span>`;
        });
    } else {
        membersHtml = '<p style="color:#95a5a6; font-size:13px;">No students registered yet</p>';
    }
    document.getElementById('modalMembers').innerHTML = membersHtml;

    $('#scheduleDetailModal').modal('show');
}

function changeWeek(direction) {
    currentWeekStart.setDate(currentWeekStart.getDate() + (direction * 7));
    loadSchedules();
}

function goToToday() {
    const today = new Date();
    const day = today.getDay();
    const diff = day === 0 ? -6 : 1 - day;
    currentWeekStart = new Date(today);
    currentWeekStart.setDate(today.getDate() + diff);
    currentWeekStart.setHours(0, 0, 0, 0);
    loadSchedules();
}

function showSection(section) {
    document.querySelectorAll('.partner-sidebar .nav-item').forEach(el => el.classList.remove('active'));
    if (section === 'schedule') {
        document.getElementById('scheduleSection').style.display = '';
        document.getElementById('profileSection').style.display = 'none';
        document.getElementById('statsRow').style.display = '';
        document.querySelectorAll('.partner-sidebar .nav-item')[0].classList.add('active');
    } else if (section === 'profile') {
        document.getElementById('scheduleSection').style.display = 'none';
        document.getElementById('profileSection').style.display = '';
        document.getElementById('statsRow').style.display = 'none';
        document.querySelectorAll('.partner-sidebar .nav-item')[1].classList.add('active');
    }
}

function toggleSidebar() {
    document.getElementById('partnerSidebar').classList.toggle('show');
}

async function handleLogout() {
    try {
        await fetch('/api/partners/logout', { method: 'POST' });
    } catch (e) {}
    window.location.href = '/partners/login';
}
</script>

    <div class="sidebar-header">
        <img id="trainerAvatar" src="https://ui-avatars.com/api/?name=T&background=3498db&color=fff&size=60" alt="Avatar">
        <h6 id="trainerName">Trainer</h6>
        <small id="trainerSpecialization">Specialization</small>
    </div>
    <div style="padding: 15px 0;">
        <a class="nav-item active" href="#" onclick="showSection('schedule')">
            <i class="fas fa-calendar-alt"></i> My Schedule
        </a>
        <a class="nav-item" href="#" onclick="showSection('profile')">
            <i class="fas fa-user"></i> Profile
        </a>
        <a class="nav-item" href="#" onclick="handleLogout()" style="margin-top: auto; color: #e74c3c;">
            <i class="fas fa-sign-out-alt"></i> Logout
        </a>
    </div>
</div>

<!-- Main Content -->
<div class="partner-content">
    <!-- Topbar -->
    <div class="partner-topbar">
        <div>
            <button class="btn btn-sm d-md-none" onclick="toggleSidebar()" style="margin-right: 10px;">
                <i class="fas fa-bars"></i>
            </button>
            <strong style="font-size: 18px; color: #2c3e50;">My Schedule</strong>
        </div>
        <div>
            <button class="btn btn-sm" onclick="goToToday()" style="background: #2c3e50; color: #fff; border-radius: 8px; padding: 6px 15px; font-size: 13px;">
                <i class="fas fa-calendar-day"></i> Today
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4" id="statsRow">
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: #3498db;"><i class="fas fa-calendar-check"></i></div>
                <div class="stat-value" id="statTotalWeek">0</div>
                <div class="stat-label">Classes This Week</div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: #2ecc71;"><i class="fas fa-users"></i></div>
                <div class="stat-value" id="statTotalMembers">0</div>
                <div class="stat-label">Total Students</div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: #e67e22;"><i class="fas fa-clock"></i></div>
                <div class="stat-value" id="statUpcoming">0</div>
                <div class="stat-label">Upcoming Today</div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: #9b59b6;"><i class="fas fa-check-circle"></i></div>
                <div class="stat-value" id="statCompleted">0</div>
                <div class="stat-label">Completed</div>
            </div>
        </div>

let regularSlotsCache = null;

async function getRegularSlots() {
  if (regularSlotsCache) return regularSlotsCache;
  try {
    const res = await fetch(`${API_BASE}/schedule/regular`);
    if (res.ok) {
      const data = await res.json();
      if (data.slots && data.slots.length > 0) {
        regularSlotsCache = data.slots;
        return regularSlotsCache;
      }
    }
  } catch (e) {}
  return FALLBACK_REGULAR_SLOTS;
}

function buildRegularSchedule(date, allSlots) {
  const dateStr = formatDateToString(date);
  const dayOfWeek = date.getDay();
  const slots = allSlots.filter(s => s.day === dayOfWeek);
  const today = new Date(); today.setHours(0,0,0,0);
  const selectedDateOnly = new Date(date); selectedDateOnly.setHours(0,0,0,0);
  const sevenDaysLater = new Date(today); sevenDaysLater.setDate(today.getDate() + 7);
  const isBookableDate = selectedDateOnly >= today && selectedDateOnly <= sevenDaysLater;
  const now = new Date();

  return slots.map((slot, index) => {
    const [h, m] = slot.time.split(':');
    const classDateTime = new Date(date);
    classDateTime.setHours(parseInt(h), parseInt(m || 0), 0, 0);
    const classEndTime = new Date(classDateTime.getTime() + parseInt(slot.duration || 60) * 60000);
    let isPast = false;
    if (selectedDateOnly.getTime() === today.getTime()) { isPast = classEndTime <= now; }
    else if (selectedDateOnly < today) { isPast = true; }
    // Booking closes 1 hour before the class starts (e.g. a 17:00 class stops taking new
    // bookings at 16:00) — separate from isPast, which only fires once the class has ended.
    const isClosingSoon = !isPast && (classDateTime.getTime() - now.getTime()) <= 60 * 60 * 1000;
    return {
      sid: `REG-${dateStr}-${index}`,
      stime: `${dateStr} ${slot.time}:00`,
      snotes: slot.classType, aname: `Coach ${slot.trainer}`,
      aimg: `/images/trainers/default.svg`, cname: 'Reguler',
      cdur: slot.duration || '60', ccap: slot.capacity || '6',
      scap: 0, sgender: '', booked: '0', bookclass: '',
      isRegular: true, isCustom: false, isLocked: false,
      isPast: isPast, isClosingSoon: isClosingSoon, isBookable: isBookableDate && !isPast,
    };
  });
}

// Google Sheets can return time-formatted cells without a leading zero (e.g. "7:00" not "07:00"),
// so `stime` strings must be parsed and compared numerically, not with localeCompare.
function parseStimeMs(stime) {
  const m = (stime || '').match(/^(\d{4})-(\d{2})-(\d{2})[ T](\d{1,2}):(\d{2})(?::(\d{2}))?/);
  if (!m) return 0;
  const [, y, mo, d, h, mi, s] = m;
  return new Date(Number(y), Number(mo) - 1, Number(d), Number(h), Number(mi), Number(s || 0)).getTime();
}

// filterByDate: when in the History tab, false shows the member's entire booking history
// (newest first, the default view); true narrows it to whichever date is selected on the
// calendar. Ignored on the Upcoming tab, which is always scoped to the selected date.
async function fetchSchedule(date, isHistory = false, filterByDate = true) {
  const dateStr = formatDateToString(date);

  if (isHistory) {
    try {
      const response = await fetch(`${API_BASE}/schedule/history`);
      if (response.ok) {
        const data = await response.json();
        // History rows are always in the past — mark them so renderClasses shows the
        // non-interactive "Selesai" state instead of Book Now/Cancel Book.
        let historyClasses = (data.schedule || []).map(s => ({ ...s, isPast: true, isBookable: false }));
        if (filterByDate) {
          historyClasses = historyClasses.filter(s => (s.stime || '').startsWith(dateStr));
        }
        classesData = historyClasses; // already sorted newest-first by the server
      } else {
        classesData = [];
      }
    } catch (err) {
      classesData = [];
    }
    renderClasses();
    updateStatusCard();
    return;
  }

  const allSlots = await getRegularSlots();
  const regularClasses = buildRegularSchedule(date, allSlots);

  let customClasses = [];
  try {
    const response = await fetch(`${API_BASE}/schedule/custom?date=${dateStr}`);
    if (response.ok) {
      const data = await response.json();
      const today = new Date(); today.setHours(0,0,0,0);
      const selDate = new Date(date); selDate.setHours(0,0,0,0);
      customClasses = (data.schedules || []).map((s, index) => {
        const [h, m] = s.time.split(':');
        const classDateTime = new Date(date);
        classDateTime.setHours(parseInt(h), parseInt(m || 0), 0, 0);
        const classEndTime = new Date(classDateTime.getTime() + parseInt(s.duration || 60) * 60000);
        const now = new Date();
        const isPast = selDate < today || (selDate.getTime() === today.getTime() && classEndTime <= now);
        return {
          sid: s.sid, stime: `${dateStr} ${s.time}:00`, snotes: s.classType,
          aname: `Coach ${s.trainer}`, aimg: `/images/trainers/default.svg`,
          cname: 'Special', cdur: s.duration || '60', ccap: s.capacity || '6',
          scap: 0, sgender: '', booked: '0', bookclass: '',
          isRegular: false, isCustom: true, isLocked: true,
          isPast: isPast, isBookable: false, customNotes: s.notes,
        };
      });
    }
  } catch (err) {}

  // The regular/custom slots above are built from templates and always report booked:'0' —
  // they don't know about bookings already made against the materialized Schedules row for
  // this date. Overlay the real per-user booked state (and live seat count) so an already-booked
  // slot shows "Cancel Book" instead of "Book Now" (re-clicking Book Now on it 400s server-side).
  try {
    const realResponse = await fetch(`${API_BASE}/schedule?date=${dateStr}`);
    if (realResponse.ok) {
      const realData = await realResponse.json();
      const realBySid = new Map((realData.schedule || []).map(s => [s.sid, s]));
      regularClasses.forEach(rc => {
        const match = realBySid.get(rc.sid);
        if (match) {
          rc.scap = match.scap;
          rc.booked = match.booked;
          rc.bookclass = match.bookclass;
        }
      });
    }
  } catch (err) {}

  classesData = [...regularClasses, ...customClasses].sort((a, b) => parseStimeMs(a.stime) - parseStimeMs(b.stime));
  renderClasses();
  updateStatusCard();
}

// Format date
function formatDate(date) {
  const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  return `${days[date.getDay()]}, ${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
}

function formatShortDate(date) {
  const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  return `${days[date.getDay()]} ${date.getDate()}`;
}

// Render calendar
function renderCalendar() {
  const datesContainer = document.getElementById('calendar-dates');
  datesContainer.innerHTML = '';
  
  const today = new Date();
  
  for (let i = 0; i < 7; i++) {
    const date = new Date(currentWeekStart);
    date.setDate(currentWeekStart.getDate() + i);
    
    const dateDiv = document.createElement('div');
    dateDiv.className = 'calendar-date';
    dateDiv.textContent = date.getDate();
    
    if (date.toDateString() === selectedDate.toDateString()) {
      dateDiv.classList.add('selected');
    }
    
    if (date.toDateString() === today.toDateString()) {
      dateDiv.classList.add('today');
    }
    
    dateDiv.onclick = () => {
      selectedDate = date;
      renderCalendar();
      updateCalendarTitle();
      fetchSchedule(selectedDate, currentTab === 'history'); // Fetch new data
    };
    
    datesContainer.appendChild(dateDiv);
  }
}

// Update calendar title
function updateCalendarTitle() {
  document.getElementById('calendar-title').textContent = formatDate(selectedDate);
}

// Render classes from API data
function renderClasses() {
  const listContainer = document.getElementById('classes-list');
  listContainer.innerHTML = '';
  
  if (classesData.length === 0) {
    listContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #666;"><i class="fi fi-rs-calendar-xmark" style="font-size: 48px; margin-bottom: 15px; display: block;"></i><strong>No classes available for the selected date</strong></div>';
    return;
  }
  
  classesData.forEach((schedule) => {
    const card = document.createElement('div');
    card.className = 'class-card';

    // Parse schedule time
    const scheduleDate = new Date(schedule.stime);
    const hours = scheduleDate.getHours().toString().padStart(2, '0');
    const minutes = scheduleDate.getMinutes().toString().padStart(2, '0');
    const timeStr = `${hours}.${minutes}`;

    const dayIndo = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'][scheduleDate.getDay()];
    const monthShort = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][scheduleDate.getMonth()];

    // Parse class name and level from snotes
    const classNotes = schedule.snotes ? schedule.snotes.replace(/\n/g, ' ').trim() : '';
    const fullClassName = schedule.isCustom
      ? `✨ ${schedule.cname} ${classNotes}`.trim()
      : `${schedule.cname} ${classNotes}`;

    // Calculate slots
    const slotsUsed = parseInt(schedule.scap) || 0;
    const slotsTotal = parseInt(schedule.ccap) || 6;
    const slotsDisplay = `${slotsUsed}/${slotsTotal}`;

    const isBooked = schedule.booked === "1" || schedule.bookclass === "booked";
    const isFull = slotsUsed >= slotsTotal;
    const isPast = schedule.isPast === true;
    const isClosingSoon = schedule.isClosingSoon === true;
    const isBookable = schedule.isBookable !== false;

    card.style = isPast
      ? 'background: #ececec; border: 2px solid #bbbbbb; border-radius: 25px; padding: 25px; margin-bottom: 15px; opacity: 0.75;'
      : 'background: white; border: 2px solid #4a3829; border-radius: 25px; padding: 25px; margin-bottom: 15px;';
    const timeBadgeColor = isPast ? '#9e9e9e' : '#4a3829';
    
    // Gender display — no badge shown when the class has no gender restriction
    let genderIcon = '';
    let genderText = '';
    let genderColor = '#8b6f47';

    if (schedule.sgender === 'F') {
      genderIcon = 'fi-rs-venus';
      genderText = 'Female Only';
      genderColor = '#e91e63';
    } else if (schedule.sgender === 'M') {
      genderIcon = 'fi-rs-mars';
      genderText = 'Male Only';
    }
    
    const isLocked = schedule.isLocked === true;

    // Determine button state — isPast is checked before isBooked so a class that's already
    // happened is never left clickable as "Cancel Book" just because the member attended it.
    let buttonHTML = '';
    if (isLocked) {
      buttonHTML = `
        <div style="text-align:center;">
          <span style="background: #6b2a2a; color: white; padding: 8px 18px; border-radius: 20px; font-size: 13px; font-weight: 600; display:inline-block; margin-bottom:6px;">
            🔒 Special Class
          </span>
          <div style="font-size:11px; color:#888;">Jadwal Khusus</div>
        </div>
      `;
    } else if (isPast) {
      buttonHTML = `
        <span style="background: #9e9e9e; color: white; padding: 10px 25px; border-radius: 20px; font-weight: 600; display: inline-block; width: 100%; text-align: center; cursor: not-allowed;">
          Selesai
        </span>
      `;
    } else if (isBooked) {
      buttonHTML = `
        <button class="cancel-btn" data-sid="${schedule.sid}" style="background: #d32f2f; color: white; border: none; padding: 10px 25px; border-radius: 20px; font-weight: 600; cursor: pointer; width: 100%;">
          Cancel Book
        </button>
      `;
    } else if (isFull) {
      buttonHTML = `
        <button class="book-btn" disabled style="background: #ccc; color: white; border: none; padding: 10px 25px; border-radius: 20px; font-weight: 600; cursor: not-allowed; width: 100%;">
          Full
        </button>
      `;
    } else if (isClosingSoon) {
      buttonHTML = `
        <span style="background: #9e9e9e; color: white; padding: 10px 25px; border-radius: 20px; font-weight: 600; display: inline-block; width: 100%; text-align: center; cursor: not-allowed;">
          Booking Ditutup
        </span>
      `;
    } else if (!isBookable) {
      buttonHTML = `
        <button class="future-btn" style="background: #ff9800; color: white; border: none; padding: 10px 25px; border-radius: 20px; font-weight: 600; cursor: pointer; width: 100%;">
          Terlalu Jauh
        </button>
      `;
    } else if (quotaRemaining !== null && quotaRemaining <= 0) {
      buttonHTML = `
        <button class="quota-btn" style="background: #ccc; color: white; border: none; padding: 10px 25px; border-radius: 20px; font-weight: 600; cursor: pointer; width: 100%;">
          Kuota Habis
        </button>
      `;
    } else {
      buttonHTML = `
        <button class="book-btn" data-sid="${schedule.sid}" style="background: #4a3829; color: white; border: none; padding: 10px 25px; border-radius: 20px; font-weight: 600; cursor: pointer; width: 100%;">
          Book Now
        </button>
      `;
    }
    
    card.innerHTML = `
      <div class="row align-items-center">
        <div class="col-md-9">
          <div class="d-flex align-items-start">
            <div class="time-badge" style="background: ${timeBadgeColor}; color: white; border-radius: 15px; padding: 15px; text-align: center; min-width: 100px; margin-right: 20px;">
              <div style="font-size: 11px; opacity: 0.8; margin-bottom: 3px;">${dayIndo}</div>
              <div style="font-size: 10px; background: #8b6f47; border-radius: 10px; padding: 3px 8px; margin-bottom: 5px; display: inline-block;">${scheduleDate.getDate()} ${monthShort}</div>
              <div style="font-size: 20px; font-weight: bold;">${timeStr}</div>
              <div style="font-size: 11px; margin-top: 3px;">${schedule.cdur} mins</div>
            </div>
            
            <div class="class-info">
              <h5 style="color: #4a3829; font-weight: 600; margin-bottom: 5px; font-size: 18px;">${fullClassName}</h5>
              <div class="class-meta" style="display: flex; flex-wrap: wrap; gap: 15px; margin-top: 10px;">
                <div style="display: flex; align-items: center; width: 100%;">
                  <i class="fi fi-rs-user" style="color: #8b6f47; margin-right: 5px;"></i>
                  <span style="color: #666; font-size: 14px;">${schedule.aname}</span>
                </div>
                ${genderText ? `
                <div style="display: flex; align-items: center; width: 100%;">
                  <i class="fi ${genderIcon}" style="color: ${genderColor}; margin-right: 5px;"></i>
                  <span style="color: ${genderColor}; font-size: 14px;">${genderText}</span>
                </div>` : ''}
                <div style="display: flex; align-items: center; width: 100%;">
                  <span style="background: ${isFull ? '#ffebee' : '#e8f5e9'}; color: ${isFull ? '#c62828' : '#2e7d32'}; padding: 3px 10px; border-radius: 10px; font-size: 12px; font-weight: 600;">${slotsDisplay}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-3 text-end">
          ${buttonHTML}
        </div>
      </div>

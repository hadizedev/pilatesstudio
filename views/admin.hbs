    <!-- Load jQuery first -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    
    <!-- Load Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    
    <script>
        // ===== Tab <-> URL query param (?view=...) =====
        const TAB_VIEW_SLUGS = {
            'schedules-tab': 'schedule',
            'users-tab': 'users',
            'memberships-tab': 'memberships',
            'bookings-tab': 'bookings',
            'classes-tab': 'classes',
            'trainers-tab': 'trainers',
            'custom-schedule-tab': 'custom-schedule',
            'regular-schedule-tab': 'regular-schedule'
        };
        const VIEW_SLUG_TO_TAB = Object.fromEntries(Object.entries(TAB_VIEW_SLUGS).map(([tabId, slug]) => [slug, tabId]));

        function activateTabFromQuery() {
            const view = new URLSearchParams(location.search).get('view');
            const tabId = view && VIEW_SLUG_TO_TAB[view];
            const tabEl = tabId && document.getElementById(tabId);
            if (tabEl) new bootstrap.Tab(tabEl).show();
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('#adminTabs button[data-bs-toggle="tab"]').forEach(btn => {
                btn.addEventListener('shown.bs.tab', function(e) {
                    const slug = TAB_VIEW_SLUGS[e.target.id];
                    if (!slug) return;
                    const url = new URL(location.href);
                    url.searchParams.set('view', slug);
                    history.replaceState(null, '', url);

                    // Custom/Regular Schedule aren't in the visible nav anymore (reached via
                    // buttons inside Schedules instead) — Bootstrap still deactivates the
                    // Schedules nav-link when they're shown, so re-highlight it with a separate
                    // class rather than Bootstrap's own "active" — mutating that directly makes
                    // Bootstrap think Schedules is already showing, so a later click to actually
                    // go back to it silently no-ops.
                    const isScheduleSubTab = e.target.id === 'custom-schedule-tab' || e.target.id === 'regular-schedule-tab';
                    document.getElementById('schedules-tab').classList.toggle('schedules-group-active', isScheduleSubTab);
                });
            });
        });

        // Initialize dashboard when DOM is ready
        $(document).ready(function() {
            console.log('=== Initializing Dashboard ===');
            console.log('jQuery:', typeof jQuery !== 'undefined' ? '✓' : '✗');
            loadAdminData();
        });

        function loadAdminData() {
            console.log('=== Fetching Admin Data ===');
            $.ajax({
                url: '/api/admin/data',
                method: 'GET',
                success: function(response) {
                    console.log('Data fetched successfully', response);
                    if (response.success) {
                        const data = response.data;
                        
                        // Store data globally for form dropdowns
                        window.adminData = data;
                        
                        // Update statistics
                        $('#totalUsers').text(data.stats.totalUsers);
                        $('#totalBookings').text(data.stats.totalBookings);
                        $('#totalClasses').text(data.stats.totalClasses);
                        $('#totalSchedules').text(data.stats.totalSchedules);
                        $('#totalTrainers').text(data.stats.totalTrainers);
                        
                        // Populate Users table
                        data.users.forEach(user => {
                            const roleClass = user.role === 'admin' ? 'status-active' : 'bg-secondary';
                            $('#usersTableBody').append(`
                                <tr>
                                    <td>${user.id}</td>
                                    <td>${user.name}</td>
                                    <td>${user.email}</td>
                                    <td>${user.phone}</td>
                                    <td>${user.password}</td>
                                    <td>${user.gender || '-'}</td>
                                    <td><span class="badge ${roleClass}">${user.role}</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" onclick='editRecord("user", ${JSON.stringify(user)})'><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteRecord('user', '${user.id}', '${user.name}')"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            `);
                        });
                        
                        // Populate Memberships tab (registration form + subscriptions table)
                        renderMemberships(data.users, data.membershipPackages, data.subscriptions);

                        // Populate Add Booking form's member dropdown
                        initAddBookingForm(data.users);

                        // Populate Bookings table
                        const usersByIdForBookings = Object.fromEntries(data.users.map(u => [u.id.toString(), u]));
                        data.bookings.forEach(booking => {
                            let statusClass = 'status-confirmed';
                            if (booking.status === 'Completed') statusClass = 'status-completed';
                            if (booking.status === 'Cancelled') statusClass = 'status-cancelled';

                            const paymentClass = booking.payment_status === 'Paid' ? 'status-paid' : 'status-pending';
                            const member = usersByIdForBookings[booking.user_id];
                            const memberLabel = member ? `${member.name} (#${booking.user_id})` : booking.user_id;
                            const cancelBtn = booking.status === 'Confirmed'
                                ? `<button class="btn btn-sm btn-danger" onclick="adminCancelBooking('${booking.id}')"><i class="fas fa-ban"></i> Cancel</button>`
                                : '';
                            const actionHTML = `<button class="btn btn-sm btn-warning" onclick='editRecord("booking", ${JSON.stringify(booking)})'><i class="fas fa-edit"></i></button> ${cancelBtn}`;

                            $('#bookingsTableBody').append(`
                                <tr>
                                    <td>${booking.id}</td>
                                    <td>${booking.schedule_id}</td>
                                    <td>${memberLabel}</td>
                                    <td>${booking.booking_time}</td>
                                    <td><span class="badge ${statusClass}">${booking.status}</span></td>
                                    <td>${booking.attended === '1' ? 'Yes' : 'No'}</td>
                                    <td><span class="badge ${paymentClass}">${booking.payment_status}</span></td>
                                    <td>${booking.credits_used}</td>
                                    <td>${booking.notes}</td>
                                    <td>${actionHTML}</td>
                                </tr>
                            `);
                        });
                        
                        // Populate Classes table
                        data.classes.forEach(cls => {
                            const statusClass = cls.status === 'Active' ? 'status-active' : 'status-inactive';
                            $('#classesTableBody').append(`
                                <tr>
                                    <td>${cls.id}</td>
                                    <td>${cls.name}</td>
                                    <td>${cls.duration} min</td>
                                    <td>${cls.capacity}</td>
                                    <td>${cls.credits_required}</td>
                                    <td><span class="badge ${statusClass}">${cls.status}</span></td>
                                    <td>${cls.description}</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" onclick='editRecord("class", ${JSON.stringify(cls)})'><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteRecord('class', '${cls.id}', '${cls.name}')"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            `);
                        });
                        
                        // Populate Schedules week view (Senin-Sabtu, past days/times disabled)
                        renderScheduleWeek();
                        
                        // Populate Trainers table
                        data.trainers.forEach(trainer => {
                            const statusClass = trainer.status === 'Active' ? 'status-active' : 'status-inactive';
                            $('#trainersTableBody').append(`
                                <tr>
                                    <td>${trainer.image ? `<img src="${trainer.image}" alt="${trainer.name}" style="width:40px;height:40px;border-radius:50%;object-fit:cover;">` : '-'}</td>
                                    <td>${trainer.id}</td>
                                    <td>${trainer.name}</td>
                                    <td>${trainer.email}</td>
                                    <td>${trainer.phone}</td>
                                    <td>${trainer.specialization}</td>
                                    <td><span class="badge ${statusClass}">${trainer.status}</span></td>
                                    <td>${trainer.bio}</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" onclick='editRecord("trainer", ${JSON.stringify(trainer)})'><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteRecord('trainer', '${trainer.id}', '${trainer.name}')"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            `);
                        });
                        
                        console.log('✓ Tables loaded successfully (using simple tables without DataTables)');
                        
                        // Hide loading spinner and show content
                        $('#loadingSpinner').hide();
                        $('#statsSection').show();
                        $('#tabsSection').show();
                        activateTabFromQuery();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', xhr, status, error);
                    $('#loadingSpinner').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i> Error loading data: ${error}
                            <br><small>Status: ${xhr.status} ${xhr.statusText}</small>
                        </div>
                    `);
                }
            });
        }
        
        // Form field definitions for each entity type
        const formFields = {
            user: [
                { name: 'name', label: 'Name', type: 'text', required: true },
                { name: 'email', label: 'Email', type: 'email', required: true },
                { name: 'phone', label: 'Phone', type: 'text', required: false },
                { name: 'address', label: 'Address', type: 'text', required: false },
                { name: 'instagram', label: 'Instagram', type: 'text', required: false },
                { name: 'password', label: 'Password', type: 'password', required: false },
                { name: 'gender', label: 'Gender', type: 'select', options: ['L', 'P'], required: false },
                { name: 'role', label: 'Role', type: 'select', options: ['member', 'admin'], required: true }
            ],
            booking: [
                { name: 'schedule_id', label: 'Schedule', type: 'select-dynamic', source: 'schedules', required: true },
                { name: 'user_id', label: 'User', type: 'select-dynamic', source: 'users', required: true },
                { name: 'status', label: 'Status', type: 'select', options: ['Confirmed', 'Completed', 'Cancelled'], required: true },
                { name: 'attended', label: 'Attended', type: 'select', options: ['0', '1'], required: true },
                { name: 'payment_status', label: 'Payment Status', type: 'select', options: ['Pending', 'Paid'], required: true },
                { name: 'credits_used', label: 'Credits Used', type: 'number', required: true },
                { name: 'notes', label: 'Notes', type: 'textarea', required: false }
            ],
            class: [
                { name: 'name', label: 'Class Name', type: 'text', required: true },
                { name: 'duration', label: 'Duration (minutes)', type: 'number', required: true },
                { name: 'capacity', label: 'Capacity', type: 'number', required: true },
                { name: 'price', label: 'Price', type: 'number', required: true },
                { name: 'credits_required', label: 'Credits Required', type: 'number', required: true },
                { name: 'status', label: 'Status', type: 'select', options: ['Active', 'Inactive'], required: true },
                { name: 'description', label: 'Description', type: 'textarea', required: false }
            ],
            schedule: [
                { name: 'schedule_time', label: 'Schedule Time', type: 'datetime-local', required: true },
                { name: 'trainer_id', label: 'Trainer', type: 'select-dynamic', source: 'trainers', required: true },
                { name: 'class_id', label: 'Class', type: 'select-dynamic', source: 'classes', required: true },
                { name: 'assigned_users', label: 'Assign Users', type: 'multiselect-dynamic', source: 'users', required: false },
                { name: 'gender_restriction', label: 'Gender Restriction', type: 'select', options: ['', 'M', 'F'], required: false },
                { name: 'status', label: 'Status', type: 'select', options: ['Active', 'Completed', 'Cancelled'], required: true },
                { name: 'notes', label: 'Notes', type: 'textarea', required: false }
            ],
            trainer: [
                { name: 'name', label: 'Name', type: 'text', required: true },
                { name: 'email', label: 'Email', type: 'email', required: true },
                { name: 'phone', label: 'Phone', type: 'text', required: true },
                { name: 'specialization', label: 'Specialization', type: 'text', required: true },
                { name: 'status', label: 'Status', type: 'select', options: ['Active', 'Inactive'], required: true },
                { name: 'bio', label: 'Bio', type: 'textarea', required: false }
            ]
        };
        
        // Cancel a member's booking on their behalf — frees their seat, marks the booking
        // Cancelled, and refunds the session to their membership, same as a member cancelling it.
        function adminCancelBooking(bookingId) {
            if (!confirm('Batalkan booking ini? Kuota member akan dikembalikan otomatis.')) return;
            $.ajax({
                url: '/api/schedule/admin/cancel',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ bookingId }),
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message || 'Gagal membatalkan booking');
                    }
                },
                error: function(xhr) {
                    alert(xhr.responseJSON?.message || 'Gagal membatalkan booking');
                }
            });
        }

        // ===== Add Booking form (Bookings tab) =====
        // Mirrors the member account page's own slot-building logic (regular template + custom
        // schedules for the chosen date, overlaid with live seat counts) so admin can book into
        // any class a member could — including slots nobody has booked into yet.
        function initAddBookingForm(users) {
            $('#addBookingMemberId').html('<option value="">Pilih member...</option>' +
                users.map(u => `<option value="${u.id}">${u.name} (${u.email})</option>`).join(''));

            if (!$('#addBookingDate').val()) {
                $('#addBookingDate').val(new Date().toISOString().split('T')[0]);
            }
            loadAddBookingSlots($('#addBookingDate').val());

            $('#addBookingDate').off('change').on('change', function() {
                loadAddBookingSlots($(this).val());
            });

            $('#addBookingForm').off('submit').on('submit', function(e) {
                e.preventDefault();
                const payload = {
                    userId: $('#addBookingMemberId').val(),
                    sid: $('#addBookingSlot').val()
                };
                if (!payload.userId || !payload.sid) {
                    alert('Pilih member dan kelas terlebih dahulu');
                    return;
                }
                $.ajax({
                    url: '/api/schedule/admin/book',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Gagal membuat booking');
                        }
                    },
                    error: function(xhr) {
                        alert(xhr.responseJSON?.message || 'Gagal membuat booking');
                    }
                });
            });
        }

        async function loadAddBookingSlots(dateStr) {
            const slotSelect = $('#addBookingSlot');
            if (!dateStr) {
                slotSelect.html('<option value="">Pilih tanggal dahulu...</option>');
                return;
            }
            slotSelect.html('<option value="">Memuat kelas...</option>');

            try {
                const [regularRes, realRes] = await Promise.all([
                    $.get('/api/schedule/regular'),
                    $.get(`/api/schedule?date=${dateStr}`)
                ]);

                const dayOfWeek = new Date(dateStr + 'T00:00:00').getDay();
                const realBySid = Object.fromEntries((realRes.schedule || []).map(s => [s.sid, s]));

                const slots = (regularRes.slots || [])
                    .filter(s => s.day === dayOfWeek)
                    .map((s, index) => {
                        const sid = `REG-${dateStr}-${index}`;
                        const real = realBySid[sid];
                        const used = real ? parseInt(real.scap, 10) || 0 : 0;
                        const capacity = parseInt(s.capacity, 10) || 6;
                        return { sid, time: s.time, label: `${s.time} - ${s.classType} (Coach ${s.trainer}) [${used}/${capacity}]`, full: used >= capacity };
                    })
                    .sort((a, b) => a.time.localeCompare(b.time));

                if (slots.length === 0) {
                    slotSelect.html('<option value="">Tidak ada kelas reguler pada tanggal ini</option>');
                    return;
                }

                slotSelect.html('<option value="">Pilih kelas...</option>' +
                    slots.map(s => `<option value="${s.sid}" ${s.full ? 'disabled' : ''}>${s.label}${s.full ? ' - PENUH' : ''}</option>`).join(''));
            } catch (err) {
                slotSelect.html('<option value="">Gagal memuat kelas</option>');
            }
        }

        // ===== Memberships tab =====
        function renderMemberships(users, packages, subscriptions) {
            const usersById = Object.fromEntries(users.map(u => [u.id.toString(), u]));
            const packagesById = Object.fromEntries((packages || []).map(p => [p.id.toString(), p]));

            // Member dropdown
            $('#membershipMemberId').html('<option value="">Pilih member...</option>' +
                users.map(u => `<option value="${u.id}">${u.name} (${u.email})</option>`).join(''));

            // Buddy dropdown (Couple packages only — shares the same session pool)
            $('#membershipBuddyId').html('<option value="">Tidak ada</option>' +
                users.map(u => `<option value="${u.id}">${u.name} (${u.email})</option>`).join(''));

            // Package dropdown — Trial's "1 sesi" isn't a normal fixed pool: it's 1 session per
            // coach, so it's clarified separately rather than looking like a single-use credit.
            const sesiLabelFor = p => p.name.trim().toLowerCase() === 'trial'
                ? `${p.credit || 1} sesi per coach`
                : (p.credit ? `${p.credit} sesi` : '-');

            $('#membershipPackageId').html('<option value="">Pilih paket...</option>' +
                (packages || []).map(p => {
                    const validLabel = p.valid_days ? `${p.valid_days} hari` : 'tanpa expire';
                    return `<option value="${p.id}">${p.name} — ${sesiLabelFor(p)} (${validLabel})</option>`;
                }).join(''));
            $('#membershipPackageId').off('change').on('change', function() {
                const pkg = packagesById[$(this).val()];

                // Buddy only makes sense for Couple packages — disable it otherwise so no stale
                // buddy value gets submitted alongside a non-Couple package.
                const isCouple = !!pkg && pkg.name.toLowerCase().includes('couple');
                $('#membershipBuddyId').prop('disabled', !isCouple);
                if (!isCouple) $('#membershipBuddyId').val('');

                if (!pkg) { $('#membershipPackageInfo').text(''); return; }
                const validLabel = pkg.valid_days ? `berlaku ${pkg.valid_days} hari` : 'tidak ada tanggal kadaluarsa';
                $('#membershipPackageInfo').text(`Rp ${parseInt(pkg.price || 0).toLocaleString('id-ID')} • ${sesiLabelFor(pkg)} • ${validLabel}`);
            });

            $('#membershipStartDate').val(new Date().toISOString().split('T')[0]);

            // Subscriptions table
            const today = new Date().toISOString().split('T')[0];
            const tbody = $('#membershipsTableBody');
            tbody.empty();
            (subscriptions || [])
                .slice()
                .sort((a, b) => (b.start_date || '').localeCompare(a.start_date || ''))
                .forEach(sub => {
                    const member = usersById[sub.member_id];
                    const isExpired = !!sub.end_date && sub.end_date < today;
                    const statusBadge = isExpired
                        ? '<span class="badge status-inactive">Expired</span>'
                        : '<span class="badge status-active">Active</span>';
                    const buddyLabel = sub.buddy_member_id
                        ? (usersById[sub.buddy_member_id]?.name || sub.buddy_name || 'Member #' + sub.buddy_member_id)
                        : '-';
                    tbody.append(`
                        <tr>
                            <td>${sub.id}</td>
                            <td>${member ? member.name : 'Member #' + sub.member_id}</td>
                            <td>${buddyLabel}</td>
                            <td>${sub.package_name}</td>
                            <td>${sub.start_date}</td>
                            <td>${sub.end_date || 'Tidak ada'}</td>
                            <td>${sub.total_sessions}</td>
                            <td>${sub.used_sessions}</td>
                            <td>${sub.remaining_sessions}</td>
                            <td>${statusBadge}</td>
                            <td>${sub.payment_name || ''}</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-warning" onclick='editMembership(${JSON.stringify(sub)})'><i class="fas fa-edit"></i></button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="deleteMembership('${sub.id}', '${(member ? member.name : 'Member #' + sub.member_id).replace(/'/g, "\\'")}', '${sub.package_name.replace(/'/g, "\\'")}')"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    `);
                });

            // Subscription rows only store the package's name, not its id — editMembership needs
            // this to preselect the right option in the Paket dropdown.
            window.membershipPackageIdByName = Object.fromEntries(
                (packages || []).map(p => [p.name.trim().toLowerCase(), p.id])
            );

            $('#membershipForm').off('submit').on('submit', function(e) {
                e.preventDefault();
                const editId = $('#membershipEditId').val();
                const payload = {
                    member_id: $('#membershipMemberId').val(),
                    package_id: $('#membershipPackageId').val(),
                    start_date: $('#membershipStartDate').val(),
                    payment_name: $('#membershipPaymentName').val(),
                    buddy_member_id: $('#membershipBuddyId').val()
                };
                if (!payload.member_id || !payload.package_id || !payload.start_date) {
                    alert('Member, paket, dan tanggal mulai wajib diisi');
                    return;
                }
                $.ajax({
                    url: editId ? `/api/admin/membership/${editId}` : '/api/admin/membership',
                    method: editId ? 'PUT' : 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Gagal menyimpan membership');
                        }
                    },
                    error: function(xhr) {
                        alert(xhr.responseJSON?.message || 'Gagal menyimpan membership');
                    }
                });
            });

            $('#membershipCancelEditBtn').off('click').on('click', resetMembershipForm);
        }


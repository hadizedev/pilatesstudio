        // ===== Schedules Week View (Senin-Sabtu) =====
        function todayStr() {
            const d = new Date();
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }

        function formatDateYMD(d) {
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }

        function getMondayOf(date) {
            const d = new Date(date);
            const day = d.getDay(); // 0=Sun..6=Sat
            const diff = day === 0 ? -6 : 1 - day;
            d.setDate(d.getDate() + diff);
            d.setHours(0, 0, 0, 0);
            return d;
        }

        let scheduleWeekStart = getMondayOf(new Date(sessionStorage.getItem('scheduleWeekStart') || new Date()));
        sessionStorage.removeItem('scheduleWeekStart');
        let scheduleWeekRenderToken = 0;

        function parseScheduleDateTime(schedule) {
            const raw = (schedule.schedule_time || '').trim();
            const m = raw.match(/^(\d{4})-(\d{2})-(\d{2})[ T](\d{1,2}):(\d{2})(?::(\d{2}))?/);
            if (!m) return null;
            const [, y, mo, d, h, mi, s] = m;
            return new Date(Number(y), Number(mo) - 1, Number(d), Number(h), Number(mi), Number(s || 0));
        }

        function scheduleDateStr(schedule) {
            const dt = parseScheduleDateTime(schedule);
            if (!dt) return '';
            return dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0') + '-' + String(dt.getDate()).padStart(2, '0');
        }

        function isSchedulePast(schedule) {
            const dt = parseScheduleDateTime(schedule);
            if (!dt) return false;
            return dt.getTime() < Date.now();
        }

        const WEEK_DAY_NAMES = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
        const SHORT_MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

        function renderScheduleWeek() {
            const myToken = ++scheduleWeekRenderToken;
            const monday = scheduleWeekStart;
            const saturday = new Date(monday);
            saturday.setDate(monday.getDate() + 5);

            const label = monday.getMonth() === saturday.getMonth()
                ? `${monday.getDate()} - ${saturday.getDate()} ${SHORT_MONTH_NAMES[monday.getMonth()]} ${monday.getFullYear()}`
                : `${monday.getDate()} ${SHORT_MONTH_NAMES[monday.getMonth()]} - ${saturday.getDate()} ${SHORT_MONTH_NAMES[saturday.getMonth()]} ${saturday.getFullYear()}`;
            $('#scheduleWeekLabel').text(label);

            const todayS = todayStr();
            let html = '';
            for (let i = 0; i < 6; i++) {
                const d = new Date(monday);
                d.setDate(monday.getDate() + i);
                const dateStr = formatDateYMD(d);
                const isPast = dateStr < todayS;
                const isToday = dateStr === todayS;
                html += `
                    <div class="schedule-day-section">
                        <button class="schedule-day-toggle ${isPast ? 'schedule-day-past' : ''}" type="button" id="day-toggle-${i}" onclick="toggleScheduleDay(${i})" aria-expanded="${isToday}">
                            <span>${WEEK_DAY_NAMES[i]}, ${d.getDate()} ${SHORT_MONTH_NAMES[d.getMonth()]} ${d.getFullYear()}</span>
                            <i class="fas fa-chevron-down chevron"></i>
                        </button>
                        <div class="collapse ${isToday ? 'show' : ''}" id="day-collapse-${i}">
                            <div class="schedule-day-body">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Time</th>
                                                <th>Coach</th>
                                                <th>Class</th>
                                                <th>Members</th>
                                                <th>Duration</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="scheduleDayBody-${i}">
                                            <tr><td colspan="6" class="text-center text-muted">Memuat jadwal...</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>`;
            }
            $('#scheduleWeekContainer').html(html);

            window.scheduleAssignQueue = [];
            for (let i = 0; i < 6; i++) {
                const d = new Date(monday);
                d.setDate(monday.getDate() + i);
                renderDaySchedule(formatDateYMD(d), i, myToken);
            }
        }

        function changeScheduleWeek(delta) {
            scheduleWeekStart.setDate(scheduleWeekStart.getDate() + delta * 7);
            renderScheduleWeek();
        }

        // Manual class/attribute toggle (not Bootstrap's data-bs-toggle) — this page loads
        // Bootstrap's JS bundle twice (layout + admin.hbs), so the two duplicate data-api click
        // listeners cancel each other out and the collapse never visibly toggles.
        function toggleScheduleDay(i) {
            const el = document.getElementById('day-collapse-' + i);
            const btn = document.getElementById('day-toggle-' + i);
            const willShow = !el.classList.contains('show');
            el.classList.toggle('show', willShow);
            btn.setAttribute('aria-expanded', String(willShow));
        }

        let regularSlotsCacheAdmin = null;

        async function getRegularSlotsAdmin() {
            if (regularSlotsCacheAdmin) return regularSlotsCacheAdmin;
            try {
                const res = await fetch('/api/schedule/regular');
                if (res.ok) {
                    const data = await res.json();
                    regularSlotsCacheAdmin = data.slots || [];
                }
            } catch (e) { /* ignore, fall through to empty */ }
            return regularSlotsCacheAdmin || [];
        }

        async function getCustomSlotsForDate(dateStr) {
            try {
                const res = await fetch(`/api/schedule/custom?date=${dateStr}`);
                if (res.ok) {
                    const data = await res.json();
                    return data.schedules || [];
                }
            } catch (e) { /* ignore, fall through to empty */ }
            return [];
        }

        function isDateTimePast(dateStr, timeStr) {
            const [y, mo, d] = dateStr.split('-').map(Number);
            const [h, mi] = (timeStr || '0:0').split(':').map(Number);
            const dt = new Date(y, mo - 1, d, h || 0, mi || 0, 0);
            return dt.getTime() < Date.now();
        }

        // Google Sheets can return time-formatted cells without a leading zero (e.g. "7:00"),
        // so time strings must be compared numerically, not lexicographically.
        function timeToMinutes(timeStr) {
            const [h, m] = (timeStr || '0:0').split(':').map(Number);
            return (h || 0) * 60 + (m || 0);
        }

        function resolveTrainerName(trainerId) {
            const t = ((window.adminData && window.adminData.trainers) || []).find(t => String(t.id) === String(trainerId));
            return t ? t.name : (trainerId || '-');
        }

        function resolveClassInfo(classId) {
            return ((window.adminData && window.adminData.classes) || []).find(c => String(c.id) === String(classId)) || null;
        }

        function resolveMemberNames(membersRaw) {
            let ids = [];
            if (Array.isArray(membersRaw)) {
                ids = membersRaw;
            } else if (typeof membersRaw === 'string' && membersRaw) {
                try {
                    const parsed = JSON.parse(membersRaw);
                    ids = Array.isArray(parsed) ? parsed : [];
                } catch (e) {
                    ids = membersRaw.split(',').map(v => v.trim()).filter(Boolean);
                }
            }
            const users = (window.adminData && window.adminData.users) || [];
            return ids.map(id => {
                const u = users.find(u => String(u.id) === String(id));
                return u ? u.name : id;
            });
        }

        async function renderDaySchedule(dateStr, dayIdx, myToken) {
            const dateObj = new Date(dateStr + 'T00:00:00');
            const tbody = $(`#scheduleDayBody-${dayIdx}`);

            const dayOfWeek = dateObj.getDay();
            const [allRegular, customSlots] = await Promise.all([
                getRegularSlotsAdmin(),
                getCustomSlotsForDate(dateStr)
            ]);
            // Bail out if a newer week render started while we were loading
            if (myToken !== scheduleWeekRenderToken) return;

            const regularSlots = allRegular.filter(s => s.day === dayOfWeek);

            const list = (window.adminData && window.adminData.schedules) || [];
            const realIndexes = [];
            list.forEach((s, idx) => { if (scheduleDateStr(s) === dateStr) realIndexes.push(idx); });

            // Map time-of-day (minutes) -> index into window.adminData.schedules, so a Regular/Custom
            // slot that already has a real Schedules row (members assigned) merges with it instead
            // of showing a duplicate row.
            const realIndexByTime = new Map();
            realIndexes.forEach(idx => {
                const timePart = (list[idx].schedule_time || '').split(/[ T]/)[1] || '';
                realIndexByTime.set(timeToMinutes(timePart), idx);
            });
            const consumedRealIndexes = new Set();

            const entries = [];

            const buildTemplateRow = (slot, notesForAssign) => {
                const past = isDateTimePast(dateStr, slot.time);
                const existingIndex = realIndexByTime.has(timeToMinutes(slot.time)) ? realIndexByTime.get(timeToMinutes(slot.time)) : -1;
                const queueIdx = window.scheduleAssignQueue.length;
                window.scheduleAssignQueue.push({
                    dateStr, time: slot.time, trainer: slot.trainer, classType: slot.classType,
                    notes: notesForAssign, existingIndex
                });

                let coach = slot.trainer, className = slot.classType, duration = slot.duration || 60, membersText = '-';
                if (existingIndex !== -1) {
                    consumedRealIndexes.add(existingIndex);
                    const schedule = list[existingIndex];
                    coach = resolveTrainerName(schedule.trainer_id);
                    const cls = resolveClassInfo(schedule.class_id);
                    className = cls ? cls.name : schedule.class_id;
                    duration = (cls && cls.duration) || slot.duration || 60;
                    const names = resolveMemberNames(schedule.members);
                    membersText = names.length ? names.join(', ') : '-';
                }

                entries.push({
                    time: timeToMinutes(slot.time),
                    html: `
                        <tr class="${past ? 'schedule-row-past' : ''}">
                            <td>${slot.time}</td>
                            <td>${coach}</td>
                            <td>${className}</td>
                            <td>${membersText}</td>
                            <td>${duration} mins</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" ${past ? 'disabled' : ''} onclick="openMemberModal(${queueIdx})" title="Edit"><i class="fas fa-edit"></i></button>
                            </td>
                        </tr>`
                });
            };

            regularSlots.forEach(slot => buildTemplateRow(slot, `Regular: ${slot.classType} (Coach ${slot.trainer})`));
            customSlots.forEach(slot => buildTemplateRow(slot, slot.notes || `Custom: ${slot.classType} (Coach ${slot.trainer})`));

            // Real Schedules rows that don't correspond to any Regular/Custom slot (e.g. created
            // directly via "Add New Schedule") still need to show up, routed through the same
            // member-only edit modal.
            realIndexes.forEach(index => {
                if (consumedRealIndexes.has(index)) return;
                const schedule = list[index];
                const past = isSchedulePast(schedule);
                const timePart = (schedule.schedule_time || '').split(/[ T]/)[1] || '';
                const cls = resolveClassInfo(schedule.class_id);
                const names = resolveMemberNames(schedule.members);
                const queueIdx = window.scheduleAssignQueue.length;
                window.scheduleAssignQueue.push({
                    dateStr, time: timePart,
                    trainer: resolveTrainerName(schedule.trainer_id),
                    classType: cls ? cls.name : schedule.class_id,
                    notes: schedule.notes, existingIndex: index
                });
                entries.push({
                    time: timeToMinutes(timePart),
                    html: `
                        <tr class="${past ? 'schedule-row-past' : ''}">
                            <td>${timePart}</td>
                            <td>${resolveTrainerName(schedule.trainer_id)}</td>
                            <td>${cls ? cls.name : schedule.class_id}</td>
                            <td>${names.length ? names.join(', ') : '-'}</td>
                            <td>${(cls && cls.duration) || 60} mins</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" ${past ? 'disabled' : ''} onclick="openMemberModal(${queueIdx})" title="Edit"><i class="fas fa-edit"></i></button>
                            </td>
                        </tr>`
                });
            });

            if (entries.length === 0) {
                tbody.html(`<tr><td colspan="6" class="text-center text-muted">Tidak ada jadwal pada tanggal ini</td></tr>`);
                return;
            }
            entries.sort((a, b) => a.time - b.time);
            tbody.html(entries.map(e => e.html).join(''));
        }

        function fuzzyMatch(list, needle) {
            const n = (needle || '').trim().toLowerCase();
            if (!n) return null;
            return list.find(item => (item.name || '').trim().toLowerCase() === n) ||
                list.find(item => {
                    const name = (item.name || '').trim().toLowerCase();
                    return name.includes(n) || n.includes(name);
                });
        }

        // Opens the member checklist modal for a schedule slot (Regular/Custom template or a
        // real Schedules row) — the "Edit" action in the Schedules table only adds/removes
        // members, it doesn't touch trainer/class/time.
        function openMemberModal(queueIdx) {
            const slot = (window.scheduleAssignQueue || [])[queueIdx];
            if (!slot) return;

            let recordId = '', trainerId = '', classId = '', scheduleTime = '', status = 'Active', notes = slot.notes || '';
            let selectedIds = [];

            if (slot.existingIndex !== -1) {
                const schedule = (window.adminData && window.adminData.schedules || [])[slot.existingIndex];
                recordId = schedule.id;
                trainerId = schedule.trainer_id;
                classId = schedule.class_id;
                scheduleTime = schedule.schedule_time;
                status = schedule.status || 'Active';
                notes = schedule.notes || '';
                try {
                    const parsed = JSON.parse(schedule.members || '[]');
                    selectedIds = Array.isArray(parsed) ? parsed.map(String) : [];
                } catch (e) { selectedIds = []; }
            } else {
                const trainerMatch = fuzzyMatch((window.adminData && window.adminData.trainers) || [], slot.trainer);
                const classMatch = fuzzyMatch((window.adminData && window.adminData.classes) || [], slot.classType);
                if (!trainerMatch || !classMatch) {
                    alert(
                        (!trainerMatch ? `Trainer "${slot.trainer}" ` : '') +
                        (!trainerMatch && !classMatch ? 'dan ' : '') +
                        (!classMatch ? `Class "${slot.classType}" ` : '') +
                        'tidak ditemukan di data Trainers/Classes.'
                    );
                }
                trainerId = trainerMatch ? trainerMatch.id : '';
                classId = classMatch ? classMatch.id : '';
                scheduleTime = `${slot.dateStr} ${slot.time}:00`;
            }

            window.memberModalData = { id: recordId, trainerId, classId, scheduleTime, status, notes };
            window.memberModalSelected = new Set(selectedIds);

            $('#memberModalTitle').text(`Kelola Member — ${slot.time} ${slot.trainer ? '(Coach ' + slot.trainer + ')' : ''}`);
            $('#memberSearchInput').val('');
            renderMemberChecklist('');

            new bootstrap.Modal(document.getElementById('memberModal')).show();
        }

        function renderMemberChecklist(searchTerm) {
            const users = (window.adminData && window.adminData.users) || [];
            const term = (searchTerm || '').trim().toLowerCase();
            const filtered = term
                ? users.filter(u => (u.name || '').toLowerCase().includes(term) || (u.email || '').toLowerCase().includes(term))
                : users;

            if (filtered.length === 0) {
                $('#memberChecklist').html('<div class="text-muted text-center p-3">Tidak ada user ditemukan</div>');
                return;
            }

            const html = filtered.map(u => {
                const checked = window.memberModalSelected.has(String(u.id)) ? 'checked' : '';
                return `
                    <label class="list-group-item d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input member-checkbox flex-shrink-0" value="${u.id}" ${checked}>
                        <span>${u.name} <small class="text-muted">${u.email || ''}</small></span>
                    </label>`;
            }).join('');
            $('#memberChecklist').html(html);

            $('.member-checkbox').on('change', function() {
                const id = String($(this).val());
                if (this.checked) window.memberModalSelected.add(id);
                else window.memberModalSelected.delete(id);
            });
        }

        $(document).on('input', '#memberSearchInput', function() {
            renderMemberChecklist($(this).val());
        });

        function saveMemberModal() {
            const data = window.memberModalData;
            if (!data) return;

            const payload = {
                schedule_time: data.scheduleTime,
                trainer_id: data.trainerId,
                class_id: data.classId,
                assigned_users: Array.from(window.memberModalSelected).join(','),
                status: data.status,
                notes: data.notes
            };

            const isEdit = !!data.id;
            $.ajax({
                url: isEdit ? `/api/admin/schedule/${data.id}` : '/api/admin/schedule',
                method: isEdit ? 'PUT' : 'POST',
                data: JSON.stringify(payload),
                contentType: 'application/json',
                success: function(response) {
                    if (response.success) {
                        sessionStorage.setItem('scheduleWeekStart', formatDateYMD(scheduleWeekStart));
                        bootstrap.Modal.getInstance(document.getElementById('memberModal')).hide();
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    alert('Error saving members: ' + (xhr.responseJSON?.message || error));
                }
            });
        }

        // Generate Form Fields
        function generateFormFields(type, data = {}) {
            console.log(`[generateFormFields] Type: ${type}, Data:`, data);
            
            const fields = formFields[type];
            let html = '';
            
            fields.forEach(field => {
                const value = data[field.name] || '';
                const required = field.required ? 'required' : '';
                
                console.log(`[Field] ${field.name} = "${value}" (type: ${field.type})`);
                
                html += `<div class="mb-3">`;
                html += `<label for="${field.name}" class="form-label">${field.label}</label>`;
                
                if (field.type === 'select') {
                    html += `<select class="form-control" id="${field.name}" name="${field.name}" ${required}>`;
                    html += `<option value="">Select ${field.label}</option>`;
                    field.options.forEach(opt => {
                        const selected = value == opt ? 'selected' : '';
                        html += `<option value="${opt}" ${selected}>${opt}</option>`;
                    });
                    html += `</select>`;
                } else if (field.type === 'select-dynamic') {
                    // Dynamic dropdown from data source
                    html += `<select class="form-control" id="${field.name}" name="${field.name}" ${required}>`;
                    html += `<option value="">Select ${field.label}</option>`;
                    
                    if (window.adminData && window.adminData[field.source]) {
                        window.adminData[field.source].forEach(item => {
                            const selected = value == item.id ? 'selected' : '';
                            
                            // Special formatting for schedules - show schedule time
                            let displayName;
                            if (field.source === 'schedules') {
                                displayName = item.schedule_time || item.stime || item.id;
                            } else {
                                displayName = item.name || item.title || item.id;
                            }
                            
                            html += `<option value="${item.id}" ${selected}>${item.id} - ${displayName}</option>`;
                        });
                    }
                    html += `</select>`;
                } else if (field.type === 'multiselect-dynamic') {
                    // Multi-select dropdown from data source
                    html += `<select class="form-control" id="${field.name}" name="${field.name}" multiple size="10" ${required} style="background-color: white;">`;
                    
                    if (window.adminData && window.adminData[field.source]) {
                        // Get assigned user IDs - could be from assigned_users (comma-separated),
                        // members (JSON array string from the Schedules sheet, e.g. '["1","2"]'),
                        // or a plain comma-separated string
                        let selectedValues = [];
                        if (data.assigned_users) {
                            selectedValues = Array.isArray(data.assigned_users) ? data.assigned_users : data.assigned_users.split(',').map(v => v.trim());
                        } else if (data.members && typeof data.members === 'string') {
                            try {
                                const parsed = JSON.parse(data.members);
                                selectedValues = Array.isArray(parsed) ? parsed.map(String) : [];
                            } catch (e) {
                                selectedValues = data.members.split(',').map(v => v.trim()).filter(Boolean);
                            }
                        } else if (Array.isArray(data.members)) {
                            selectedValues = data.members.map(String);
                        } else if (value) {
                            selectedValues = Array.isArray(value) ? value : value.split(',').map(v => v.trim());
                        }
                        
                        console.log('Selected user IDs for multiselect:', selectedValues);
                        
                        window.adminData[field.source].forEach(item => {
                            const isSelected = selectedValues.includes(String(item.id));
                            const selectedAttr = isSelected ? 'selected' : '';
                            const classAttr = isSelected ? 'class="user-assigned"' : '';
                            const displayName = item.name || item.title || item.id;
                            html += `<option value="${item.id}" ${selectedAttr} ${classAttr}>${item.id} - ${displayName}</option>`;
                        });
                    }
                    html += `</select>`;
                    html += `<small class="form-text text-muted">Hold Ctrl/Cmd to select multiple users. <strong style="color: #0d6efd;">■ Blue = Currently assigned members</strong></small>`;
                } else if (field.type === 'textarea') {
                    html += `<textarea class="form-control" id="${field.name}" name="${field.name}" rows="3" ${required}>${value}</textarea>`;
                } else if (field.type === 'datetime-local') {
                    // Convert datetime format from "YYYY-MM-DD HH:MM:SS" to "YYYY-MM-DDTHH:MM"
                    let inputValue = value;
                    console.log(`[DateTime Debug] Field: ${field.name}, Original Value: "${value}", Type: ${typeof value}`);
                    
                    if (value && value.includes(' ')) {
                        // Format: "2025-12-20 16:00:00" or "2025-12-20 8:00:00" -> "2025-12-20T16:00" or "2025-12-20T08:00"
                        const [datePart, timePart] = value.split(' ');
                        
                        // Parse time parts and pad with zeros if needed
                        const timeComponents = timePart.split(':');
                        const hours = timeComponents[0].padStart(2, '0');
                        const minutes = timeComponents[1].padStart(2, '0');
                        
                        inputValue = `${datePart}T${hours}:${minutes}`;
                        console.log(`[DateTime Debug] Converted Value: "${inputValue}"`);
                    } else {
                        console.log(`[DateTime Debug] No conversion needed or empty value`);
                    }
                    
                    html += `<input type="${field.type}" class="form-control" id="${field.name}" name="${field.name}" value="${inputValue}" ${required}>`;
                } else {
                    // For edit mode on password field, don't show existing value
                    const inputValue = field.name === 'password' && data.id ? '' : value;
                    const placeholder = field.name === 'password' && data.id ? 'Leave empty to keep current password' : '';
                    const readonlyAttr = field.readonly ? 'readonly style="background-color: #e9ecef;"' : '';
                    html += `<input type="${field.type}" class="form-control" id="${field.name}" name="${field.name}" value="${inputValue}" placeholder="${placeholder}" ${required} ${readonlyAttr}>`;
                }
                
                html += `</div>`;
            });
            
            $('#formFields').html(html);
            
            // Add event listener for class_id change to auto-fill members
            $('#class_id').on('change', function() {
                const classId = $(this).val();
                if (classId && window.adminData && window.adminData.classes) {
                    const selectedClass = window.adminData.classes.find(c => c.id == classId);
                    if (selectedClass && selectedClass.capacity) {
                        $('#members').val(selectedClass.capacity);
                        console.log('Auto-filled members with capacity:', selectedClass.capacity);
                    }
                }
            });
            
            // Add event listener for assigned_users to validate capacity
            if (type === 'schedule') {
                $('#assigned_users').on('change', function() {
                    const selectedUsers = $(this).val() || [];
                    const classId = $('#class_id').val();
                    
                    if (classId && window.adminData && window.adminData.classes) {
                        const selectedClass = window.adminData.classes.find(c => c.id == classId);
                        if (selectedClass && selectedClass.capacity) {
                            const capacity = parseInt(selectedClass.capacity);
                            const selectedCount = selectedUsers.length;
                            
                            if (selectedCount > capacity) {
                                alert(`⚠️ WARNING!\n\nYou have selected ${selectedCount} users, but the class capacity is only ${capacity}.\n\nPlease remove ${selectedCount - capacity} user(s) to match the capacity limit.`);
                                
                                // Show visual warning
                                $(this).css('border', '3px solid red');
                                $(this).next('small').html(`<strong style="color: red;">⚠️ CAPACITY EXCEEDED! Selected: ${selectedCount}/${capacity} - Remove ${selectedCount - capacity} user(s)</strong>`);
                            } else if (selectedCount === capacity) {
                                // At capacity - show yellow warning
                                $(this).css('border', '2px solid #ffc107');
                                $(this).next('small').html(`<strong style="color: #ffc107;">⚠️ FULL! Selected: ${selectedCount}/${capacity} users</strong>`);
                            } else {
                                // Under capacity - show normal
                                $(this).css('border', '1px solid #ced4da');
                                $(this).next('small').html(`Hold Ctrl/Cmd to select multiple users. <strong style="color: #0d6efd;">■ Blue = Currently assigned members</strong> | <strong style="color: #28a745;">Selected: ${selectedCount}/${capacity}</strong>`);
                            }
                        }
                    }
                });
                
                // Trigger initial check if editing
                if (data.id) {
                    setTimeout(() => $('#assigned_users').trigger('change'), 100);
                }
            }
        }
        
        // Save Record (Create or Update)
        function saveRecord() {
            const type = $('#recordType').val();
            const id = $('#recordId').val();
            const isEdit = id !== '';
            
            // Special validation for schedule
            if (type === 'schedule') {
                const selectedUsers = $('#assigned_users').val() || [];
                const classId = $('#class_id').val();
                
                if (classId && window.adminData && window.adminData.classes) {
                    const selectedClass = window.adminData.classes.find(c => c.id == classId);
                    if (selectedClass && selectedClass.capacity) {
                        const capacity = parseInt(selectedClass.capacity);
                        const selectedCount = selectedUsers.length;
                        
                        if (selectedCount > capacity) {
                            alert(`❌ CANNOT SAVE!\n\nYou have assigned ${selectedCount} users, but the class capacity is only ${capacity}.\n\nPlease remove ${selectedCount - capacity} user(s) before saving.`);
                            $('#assigned_users').css('border', '3px solid red').focus();
                            return;
                        }
                    }
                }
            }
            
            // Collect form data
            const formData = {};
            $('#crudForm').find('input, select, textarea').each(function() {
                const name = $(this).attr('name');
                if (name && name !== '') {
                    // Handle multi-select
                    if ($(this).attr('multiple')) {
                        const selectedValues = $(this).val();
                        formData[name] = selectedValues ? selectedValues.join(',') : '';
                    } else {
                        formData[name] = $(this).val();
                    }
                }
            });
            
            // Validate required fields
            let isValid = true;
            $('#crudForm').find('[required]').each(function() {
                if (!$(this).val() || ($(this).attr('multiple') && $(this).val().length === 0)) {
                    $(this).addClass('is-invalid');
                    isValid = false;
                } else {
                    $(this).removeClass('is-invalid');
                }
            });
            
            if (!isValid) {
                alert('Please fill all required fields');
                return;
            }
            
            // Bookings route through dedicated endpoints that keep the Schedules seat count and
            // member quota in sync with whatever this form changes (see schedule.js) — a raw
            // generic write here would silently desync them from the actual booking record.
            let url, method, payload = formData;
            if (type === 'booking') {
                if (isEdit) {
                    url = `/api/schedule/admin/booking/${id}`;
                    method = 'PUT';
                } else {
                    url = '/api/schedule/admin/book';
                    method = 'POST';
                    payload = { sid: formData.schedule_id, userId: formData.user_id };
                }
            } else {
                url = isEdit ? `/api/admin/${type}/${id}` : `/api/admin/${type}`;
                method = isEdit ? 'PUT' : 'POST';
            }

            $.ajax({
                url: url,
                method: method,
                data: JSON.stringify(payload),
                contentType: 'application/json',
                success: function(response) {
                    if (response.success) {
                        alert(isEdit ? 'Record updated successfully' : 'Record created successfully');
                        bootstrap.Modal.getInstance(document.getElementById('crudModal')).hide();
                        if (type === 'schedule' && typeof scheduleWeekStart !== 'undefined') {
                            sessionStorage.setItem('scheduleWeekStart', formatDateYMD(scheduleWeekStart));
                        }
                        // Reload page to refresh data
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Save error:', xhr, status, error);
                    alert('Error saving record: ' + (xhr.responseJSON?.message || error));
                }
            });
        }
        
        // Delete Record
        function deleteRecord(type, id, name) {
            if (!confirm(`Are you sure you want to delete this ${type}: ${name}?`)) {
                return;
            }
            
            $.ajax({
                url: `/api/admin/${type}/${id}`,
                method: 'DELETE',
                success: function(response) {
                    if (response.success) {
                        alert('Record deleted successfully');
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Delete error:', xhr, status, error);
                    alert('Error deleting record: ' + (xhr.responseJSON?.message || error));
                }
            });
        }
        // ===== Custom Schedule Functions =====
        async function loadCustomSchedules() {
            try {
                const res = await fetch('/api/schedule/custom/all');
                if (!res.ok) return;
                const data = await res.json();
                const tbody = document.getElementById('customSchedulesTableBody');
                if (!data.schedules || data.schedules.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted">Belum ada jadwal custom</td></tr>';
                    return;
                }
                tbody.innerHTML = data.schedules.map(s => `
                    <tr>
                        <td><small>${s.id}</small></td>
                        <td>${s.date}</td>
                        <td>${s.time}</td>
                        <td>${s.trainer}</td>
                        <td><span class="badge bg-info">${s.classType}</span></td>
                        <td>${s.duration} mnt</td>
                        <td>${s.capacity}</td>
                        <td>${s.notes || '-'}</td>
                        <td><small>${s.createdBy || '-'}</small></td>
                        <td>
                            <button class="btn btn-sm btn-danger" onclick="deleteCustomSchedule('${s.id}')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } catch(e) {
                console.error('Error loading custom schedules:', e);
            }
        }

        async function createCustomSchedule() {
            const date = document.getElementById('cs-date').value;
            const time = document.getElementById('cs-time').value;
            const trainer = document.getElementById('cs-trainer').value;
            const classType = document.getElementById('cs-class-type').value;
            const duration = document.getElementById('cs-duration').value;
            const capacity = document.getElementById('cs-capacity').value;
            const notes = document.getElementById('cs-notes').value;

            if (!date || !time) {
                alert('Tanggal dan jam wajib diisi!');
                return;
            }

            try {
                const res = await fetch('/api/schedule/custom', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ date, time, trainer, classType, duration, capacity, notes })
                });
                const data = await res.json();
                if (data.success) {
                    alert('Jadwal custom berhasil dibuat!');
                    loadCustomSchedules();
                    document.getElementById('cs-date').value = '';
                    document.getElementById('cs-time').value = '';
                    document.getElementById('cs-notes').value = '';
                } else {
                    alert('Gagal: ' + (data.error || 'Unknown error'));
                }
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        async function deleteCustomSchedule(id) {
            if (!confirm('Hapus jadwal custom ini?')) return;
            try {
                const res = await fetch(`/api/schedule/custom/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    alert('Jadwal dihapus!');
                    loadCustomSchedules();
                    if (typeof renderScheduleWeek !== 'undefined') renderScheduleWeek();
                } else {
                    alert('Gagal: ' + (data.error || 'Unknown error'));
                }
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        document.getElementById('custom-schedule-tab').addEventListener('click', loadCustomSchedules);
        document.getElementById('regular-schedule-tab').addEventListener('click', () => loadDaySchedule(1, document.querySelector('#dayTabs .nav-link.active')));

        // ===== Regular Schedule Functions =====
        let regularScheduleAll = [];
        let currentDay = 1;

        async function loadAllRegularSlots() {
            try {
                const res = await fetch('/api/schedule/regular?all=1');
                if (res.ok) {
                    const data = await res.json();
                    regularScheduleAll = data.slots || [];
                }
            } catch(e) {
                console.error('Error loading regular schedule:', e);
            }
        }

        function loadDaySchedule(day, btn) {
            currentDay = day;
            document.getElementById('rs-day').value = day;
            // Update active pill
            document.querySelectorAll('#dayTabs .nav-link').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const daySlots = regularScheduleAll.filter(s => s.day === day)
                .sort((a, b) => timeToMinutes(a.time) - timeToMinutes(b.time));

            const tbody = document.getElementById('regularSlotsTableBody');
            if (daySlots.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Tidak ada jadwal. Tambah slot baru di bawah.</td></tr>';
                return;
            }

            tbody.innerHTML = daySlots.map(s => `
                <tr>
                    <td><strong>${s.time}</strong></td>
                    <td>Coach ${s.trainer}</td>
                    <td><span class="badge ${s.classType === 'Tower' ? 'bg-info' : 'bg-primary'}">${s.classType}</span></td>
                    <td>${s.duration || 60} mnt</td>
                    <td>${s.capacity || 6} orang</td>
                    <td>
                        <span class="badge ${s.visible ? 'bg-success' : 'bg-secondary'}">${s.visible ? 'Tampil' : 'Disembunyikan'}</span>
                    </td>
                    <td>
                        <button class="btn btn-sm ${s.visible ? 'btn-outline-secondary' : 'btn-outline-success'}" onclick="toggleRegularSlotVisible('${s.id}', ${!s.visible})">
                            <i class="fas ${s.visible ? 'fa-eye-slash' : 'fa-eye'}"></i> ${s.visible ? 'Sembunyikan' : 'Tampilkan'}
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="deleteRegularSlot('${s.id}')">
                            <i class="fas fa-trash"></i> Hapus
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        async function addRegularSlot() {
            const day      = parseInt(document.getElementById('rs-day').value);
            const time     = document.getElementById('rs-time').value;
            const trainer  = document.getElementById('rs-trainer').value;
            const classType= document.getElementById('rs-classtype').value;
            const duration = document.getElementById('rs-duration').value;
            const capacity = document.getElementById('rs-capacity').value;

            if (!time) { alert('Jam wajib diisi!'); return; }

            // Check duplicate
            if (regularScheduleAll.some(s => s.day === day && s.time === time)) {
                alert(`Sudah ada jadwal jam ${time} di hari ini!`);
                return;
            }

            try {
                const res = await fetch('/api/schedule/regular', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ day, time, trainer, classType, duration, capacity })
                });
                const data = await res.json();
                if (data.success) {
                    // Optimistic update
                    regularScheduleAll.push({ id: data.id, day, time, trainer, classType, duration, capacity, visible: true });
                    loadDaySchedule(day, null);
                    document.getElementById('rs-time').value = '';
                    alert(`Slot ${time} berhasil ditambahkan!`);
                } else {
                    alert('Gagal: ' + (data.error || 'Unknown error'));
                }
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        async function toggleRegularSlotVisible(id, visible) {
            try {
                const res = await fetch(`/api/schedule/regular/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ visible })
                });
                const data = await res.json();
                if (data.success) {
                    const slot = regularScheduleAll.find(s => s.id === id);
                    if (slot) slot.visible = visible;
                    loadDaySchedule(currentDay, null);
                } else {
                    alert('Gagal: ' + (data.error || 'Unknown error'));
                }
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        async function deleteRegularSlot(id) {
            if (!confirm('Hapus slot jadwal regular ini?')) return;
            try {
                const res = await fetch(`/api/schedule/regular/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    regularScheduleAll = regularScheduleAll.filter(s => s.id !== id);
                    loadDaySchedule(currentDay, null);
                    alert('Slot berhasil dihapus!');
                } else {
                    alert('Gagal: ' + (data.error || 'Unknown error'));
                }
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        // Pre-load regular schedule when admin page loads
        loadAllRegularSlots();
    </script>
</body>
</html>
